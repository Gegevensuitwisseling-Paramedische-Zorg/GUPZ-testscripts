{
    "request": {
        "method": "GET",
        "urlPathPattern": ".*"
    },
    "response": {
        "status": 404,
        "headers": {
            "Content-Type": "application/fhir+json"
        },
        "jsonBody": {
            "resourceType": "OperationOutcome",
            "issue": [
                {
                    "severity": "error",
                    "code": "not-supported",
                    "diagnostics": "DocumentManifest is not supported by this data platform."
                }
            ]
        }
    }
}
