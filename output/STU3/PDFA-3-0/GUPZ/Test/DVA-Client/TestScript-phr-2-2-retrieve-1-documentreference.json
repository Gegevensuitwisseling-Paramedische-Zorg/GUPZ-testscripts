  "contact": [
    {
      "telecom": [
        {
          "system": "url",
          "value": "https://github.com/Gegevensuitwisseling-Paramedische-Zorg/GUPZ-testscripts"
        }
      ],
      "name": "GUPZ"
    }
  ],
  "origin": [
    {
      "index": 1,
      "profile": {
        "code": "FHIR-Client",
        "system": "http://terminology.hl7.org/CodeSystem/testscript-profile-origin-types"
      }
    }
  ],
  "destination": [
    {
      "index": 1,
      "profile": {
        "code": "Conformancelab-Server",
        "system": "http://fhir.interoplab.eu/fhir/CodeSystem/Interoplab-CL-destination-profile"
      }
    }
  ],
  "test": [
    {
      "extension": [
        {
          "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-test-request-mode",
          "valueCode": "extra-allowed"
        }
      ],
      "action": [
        {
          "operation": {
            "type": {
              "code": "read",
              "system": "http://hl7.org/fhir/restful-interaction"
            },
            "resource": "DocumentReference",
            "description": "Test PHR client to read DocumentReference resource.",
            "params": "/pdfa-documentreference4",
            "destination": 1,
            "origin": 1,
            "encodeRequestUrl": true
          }
        },
        {
          "assert": {
            "extension": [
              {
                "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-assert-additional-operators",
                "valueCode": "exists"
              }
            ],
            "description": "Confirm that the request carries an Authorization header. Its value cannot be compared to a fixed string, because a GUPZ token is encrypted and differs on every run.",
            "direction": "request",
            "headerField": "Authorization",
            "stopTestOnFail": false,
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "Confirm that the Authorization header uses the Bearer scheme, as security.md prescribes.",
            "direction": "request",
            "headerField": "Authorization",
            "operator": "contains",
            "value": "Bearer ",
            "stopTestOnFail": false,
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "Confirm that query parameter 'patient=' was not present to avoid BSNs in the URL.",
            "direction": "request",
            "operator": "notContains",
            "requestURL": "patient=",
            "stopTestOnFail": false,
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "Confirm that query parameter 'subject=' was not present to avoid BSNs in the URL.",
            "direction": "request",
            "operator": "notContains",
            "requestURL": "subject=",
            "stopTestOnFail": false,
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "Confirm that the operation was successful",
            "operator": "in",
            "responseCode": "200,201",
            "stopTestOnFail": true,
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "Make sure that the server of the test simulator returns the requested DocumentReference resource.",
            "direction": "response",
            "resource": "DocumentReference",
            "stopTestOnFail": false,
            "warningOnly": false
          }
        }
      ],
      "id": "scenario2-2-retrieve-1-documentreference",
      "name": "Scenario 2.2",
      "description": "Read DocumentReference resource."
    }
  ],
  "version": "0.1.0",
  "status": "active",
  "publisher": "GUPZ",
  "name": "Phr_2_2_retrieve_1_documentreference",
  "title": "Scenario 2.2 - Retrieve one DocumentReference resource",
  "description": "Scenario 2.2 - Retrieve one DocumentReference resource of XXX-Schulte based on a retrieved reference in a DocumentManifest resource (scenario 2.1)."
}
