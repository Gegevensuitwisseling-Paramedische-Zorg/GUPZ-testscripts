  "origin": [
    {
      "index": 1,
      "profile": {
        "code": "Conformancelab-Client",
        "system": "http://fhir.interoplab.eu/fhir/CodeSystem/Interoplab-CL-origin-profile"
      }
    }
  ],
  "destination": [
    {
      "index": 1,
      "profile": {
        "code": "FHIR-Server",
        "system": "http://terminology.hl7.org/CodeSystem/testscript-profile-destination-types"
      }
    }
  ],
  "profile": [
    "http://hl7.org/fhir/StructureDefinition/OperationOutcome"
  ],
  "_profile": [
    {
      "id": "OperationOutcome-profile"
    }
  ],
  "variable": [
    {
      "name": "patient-token-XXX_Baltus",
      "defaultValue": "Bearer f92b6141-55db-46d5-a3ae-874b69907d22",
      "description": "OAuth Token for patient 'XXX_Baltus'"
    }
  ],
  "test": [
    {
      "action": [
        {
          "operation": {
            "requestHeader": [
              {
                "field": "Authorization",
                "value": "${patient-token-XXX_Baltus}"
              }
            ],
            "type": {
              "code": "read",
              "system": "http://hl7.org/fhir/restful-interaction"
            },
            "resource": "Binary",
            "description": "Test XIS server to serve Binary resource.",
            "params": "/example-pdfa-binary3",
            "destination": 1,
            "origin": 1,
            "encodeRequestUrl": true,
            "accept": "json"
          }
        },
        {
          "assert": {
            "description": "Confirm that the returned HTTP status is 404 (Not Found) or 410 (Gone).",
            "direction": "response",
            "operator": "in",
            "responseCode": "404,410",
            "stopTestOnFail": true,
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "Confirm that the returned resource type is OperationOutcome.",
            "direction": "response",
            "resource": "OperationOutcome",
            "stopTestOnFail": false,
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "Confirm that the returned OperationOutcome conforms to the base FHIR specification.",
            "direction": "response",
            "stopTestOnFail": false,
            "validateProfileId": "OperationOutcome-profile",
            "warningOnly": false
          }
        }
      ],
      "id": "scenario1-5-serve-0-binary",
      "name": "Scenario 1.5",
      "description": "Serve OperationOutcome resource because the id of the requested read should not exist at the XIS server."
    }
  ],
  "version": "stu3-2.0-patchlevel 2026.30",
  "status": "active",
  "publisher": "Nictiz",
  "name": "Xis_1_5_serve_0_binary_NoManifest_json",
