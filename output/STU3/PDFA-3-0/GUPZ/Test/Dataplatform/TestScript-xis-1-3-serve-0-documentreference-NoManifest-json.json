{
  "resourceType": "TestScript",
  "id": "xis-1-3-serve-0-documentreference-NoManifest-json",
  "url": "http://gupz.nl/fhir/TestScript/xis-1-3-serve-0-documentreference-NoManifest-json",
  "contact": [
    {
      "telecom": [
        {
          "system": "url",
          "value": "https://github.com/Gegevensuitwisseling-Paramedische-Zorg/GUPZ-testscripts"
        }
      ],
      "name": "GUPZ"
    }
  ],
  "origin": [
    {
      "index": 1,
      "profile": {
        "code": "Conformancelab-Client",
        "system": "http://fhir.interoplab.eu/fhir/CodeSystem/Interoplab-CL-origin-profile"
      }
    }
  ],
  "destination": [
    {
      "index": 1,
      "profile": {
        "code": "FHIR-Server",
        "system": "http://terminology.hl7.org/CodeSystem/testscript-profile-destination-types"
      }
    }
  ],
  "profile": [
    "http://hl7.org/fhir/StructureDefinition/OperationOutcome"
  ],
  "_profile": [
    {
      "id": "OperationOutcome-profile"
    }
  ],
  "variable": [
    {
      "name": "patient-token-XXX_Baltus",
      "description": "GUPZ token for test patient 'XXX_Baltus'. Paste the nested JWT issued for this patient; the script adds the Bearer prefix. A token used in a patient bound request is patient specific since open-GUPZ issue #73 closed on 18 August, so each test patient needs a token of their own."
    }
  ],
  "test": [
    {
      "action": [
        {
          "operation": {
            "requestHeader": [
              {
                "field": "Authorization",
                "value": "Bearer ${patient-token-XXX_Baltus}"
              }
            ],
            "type": {
              "code": "search",
              "system": "http://hl7.org/fhir/restful-interaction"
            },
            "resource": "DocumentReference",
            "description": "Test XIS server to serve DocumentReference resources.",
            "params": "/$",
            "destination": 1,
            "origin": 1,
            "encodeRequestUrl": true,
            "accept": "json"
          }
        },
        {
          "assert": {
            "description": "Confirm that the returned HTTP status is 400 (Bad Request).",
            "direction": "response",
            "operator": "equals",
            "responseCode": "400",
            "stopTestOnFail": true,
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "Confirm that the returned resource type is OperationOutcome.",
            "direction": "response",
            "resource": "OperationOutcome",
            "stopTestOnFail": false,
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "Confirm that the returned OperationOutcome conforms to the base FHIR specification.",
            "direction": "response",
            "stopTestOnFail": false,
            "validateProfileId": "OperationOutcome-profile",
            "warningOnly": false
          }
        }
      ],
      "id": "scenario1-3-serve-0-documentreference",
      "name": "Scenario 1.3",
      "description": "Serve OperationOutcome resource for the incorrect search request."
    }
  ],
  "version": "0.1.0",
  "status": "active",
  "publisher": "GUPZ",
  "name": "Xis_1_3_serve_0_documentreference_NoManifest_json",
  "title": "Scenario 1.3 - Serve zero DocumentReference resources and one OperationOutcome resource - target NoManifest - JSON Format",
  "description": "Scenario 1.3 - Serve OperationOutome resource for a request with an incorrect search syntax."
}
