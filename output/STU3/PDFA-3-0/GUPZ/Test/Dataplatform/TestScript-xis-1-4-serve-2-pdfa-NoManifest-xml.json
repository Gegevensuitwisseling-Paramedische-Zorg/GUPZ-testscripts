          }
        }
      ],
      "id": "scenario1-4-serve-pdfa-document-2",
      "name": "Scenario 1.4 - Serve second PDFA document",
      "description": "Serve second PDFA document through a Binary resource."
    }
  ],
  "version": "0.1.0",
