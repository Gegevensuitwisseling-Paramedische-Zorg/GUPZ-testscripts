{
  "resourceType": "TestScript",
  "id": "self-dva-01-envelope-conforms",
  "url": "http://gupz.nl/fhir/TestScript/self-dva-01-envelope-conforms",
  "contact": [
    {
      "telecom": [
        {
          "system": "url",
          "value": "https://github.com/Gegevensuitwisseling-Paramedische-Zorg/GUPZ-testscripts"
        }
      ],
      "name": "GUPZ"
    }
  ],
  "origin": [
    {
      "index": 1,
      "profile": {
        "code": "FHIR-Client",
        "system": "http://terminology.hl7.org/CodeSystem/testscript-profile-origin-types"
      }
    }
  ],
  "destination": [
    {
      "extension": [
        {
          "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-destination-title",
          "valueString": "FHIR endpoint"
        }
      ],
      "index": 1,
      "profile": {
        "code": "Conformancelab-Server",
        "system": "http://fhir.interoplab.eu/fhir/CodeSystem/Interoplab-CL-destination-profile"
      }
    }
  ],
  "variable": [
    {
      "name": "self-dva-01-token",
      "defaultValue": "eyJhbGciOiJSU0EtT0FFUCIsImVuYyI6IkEyNTZDQkMtSFM1MTIiLCJjdHkiOiJKV1QiLCJraWQiOiJndXB6LXNlbGYtdGVzdC1rZXkifQ.c2VsZi10ZXN0LWVuY3J5cHRlZC1rZXk.c2VsZi10ZXN0LWl2.c2VsZi10ZXN0LWNpcGhlcnRleHQ.c2VsZi10ZXN0LXRhZw",
      "description": "The token this self test presents. A synthetic string, not a credential."
    },
    {
      "extension": [
        {
          "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-variable-regex-mapper",
          "valueString": "(?<=Bearer ).*$"
        }
      ],
      "name": "dva-token",
      "headerField": "Authorization",
      "sourceId": "self-dva-01-request",
      "description": "The token the caller sent, without the Bearer prefix."
    },
    {
      "extension": [
        {
          "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-variable-regex-mapper",
          "valueString": "(?<=Bearer )[A-Za-z0-9_-]+"
        }
      ],
      "name": "dva-token-header",
      "headerField": "Authorization",
      "sourceId": "self-dva-01-request",
      "description": "The protected header of the JWE, still base64url encoded."
    }
  ],
  "test": [
    {
      "extension": [
        {
          "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-test-request-mode",
          "valueCode": "extra-allowed"
        }
      ],
      "action": [
        {
          "operation": {
            "requestHeader": [
              {
                "field": "Authorization",
                "value": "Bearer ${self-dva-01-token}"
              }
            ],
            "type": {
              "code": "search",
              "system": "http://hl7.org/fhir/restful-interaction"
            },
            "resource": "DocumentReference",
            "params": "?status=current",
            "requestId": "self-dva-01-request",
            "destination": 1,
            "origin": 1,
            "encodeRequestUrl": true,
            "description": "Send the search DVA-01 expects, carrying a token with a conforming JWE header."
          }
        },
        {
          "assert": {
            "extension": [
              {
                "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-assert-additional-operators",
                "valueCode": "exists"
              }
            ],
            "description": "Confirm that the request carries an Authorization header. Its value cannot be compared to a fixed string, because a GUPZ token is encrypted and differs on every run.",
            "direction": "request",
            "headerField": "Authorization",
            "stopTestOnFail": false,
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "Confirm that the Authorization header uses the Bearer scheme, as security.md prescribes.",
            "direction": "request",
            "headerField": "Authorization",
            "operator": "contains",
            "value": "Bearer ",
            "stopTestOnFail": false,
            "warningOnly": false
          }
        },
        {
          "assert": {
            "extension": [
              {
                "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-assert-input-variable",
                "valueString": "dva-token"
              }
            ],
            "description": "Confirm that the token is a JWE in compact serialization, which has five dot separated parts. A token that was signed but not encrypted has three.",
            "direction": "request",
            "stopTestOnFail": true,
            "warningOnly": false,
            "_value": {
              "extension": [
                {
                  "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-assert-regex-matches",
                  "valueString": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]*\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
                }
              ]
            }
          }
        },
        {
          "assert": {
            "extension": [
              {
                "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-assert-input-variable",
                "valueString": "dva-token-header"
              },
              {
                "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-assert-mapper-function",
                "valueCode": "base64Decode"
              }
            ],
            "description": "Confirm that the JWE header declares alg as RSA-OAEP, the key encryption algorithm.",
            "direction": "request",
            "stopTestOnFail": false,
            "warningOnly": false,
            "_value": {
              "extension": [
                {
                  "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-assert-regex-matches",
                  "valueString": "\"alg\"\\s*:\\s*\"RSA-OAEP\""
                }
              ]
            }
          }
        },
        {
          "assert": {
            "extension": [
              {
                "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-assert-input-variable",
                "valueString": "dva-token-header"
              },
              {
                "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-assert-mapper-function",
                "valueCode": "base64Decode"
              }
            ],
            "description": "Confirm that the JWE header declares enc as A256CBC-HS512, the content encryption algorithm.",
            "direction": "request",
            "stopTestOnFail": false,
            "warningOnly": false,
            "_value": {
              "extension": [
                {
                  "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-assert-regex-matches",
                  "valueString": "\"enc\"\\s*:\\s*\"A256CBC-HS512\""
                }
              ]
            }
          }
        },
        {
          "assert": {
            "extension": [
              {
                "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-assert-input-variable",
                "valueString": "dva-token-header"
              },
              {
                "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-assert-mapper-function",
                "valueCode": "base64Decode"
              }
            ],
            "description": "Confirm that the JWE header declares cty as JWT, which is what marks the payload as a nested JWT.",
            "direction": "request",
            "stopTestOnFail": false,
            "warningOnly": false,
            "_value": {
              "extension": [
                {
                  "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-assert-regex-matches",
                  "valueString": "\"cty\"\\s*:\\s*\"JWT\""
                }
              ]
            }
          }
        },
        {
          "assert": {
            "extension": [
              {
                "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-assert-input-variable",
                "valueString": "dva-token-header"
              },
              {
                "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-assert-mapper-function",
                "valueCode": "base64Decode"
              }
            ],
            "description": "Check whether the JWE header names the key it was encrypted with. Warning only: security.md requires a kid on the JWS header, which cannot be read from outside, and its JWE header table does not list one. Reported because key rotation under open-GUPZ issue #27 needs it.",
            "direction": "request",
            "stopTestOnFail": false,
            "warningOnly": true,
            "_value": {
              "extension": [
                {
                  "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-assert-regex-matches",
                  "valueString": "\"kid\"\\s*:\\s*\"[^\"]+\""
                }
              ]
            }
          }
        },
        {
          "assert": {
            "extension": [
              {
                "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-assert-additional-operators",
                "valueCode": "notExists"
              },
              {
                "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-assert-query-parameter",
                "valueString": "patient"
              }
            ],
            "description": "Confirm that query parameter 'patient' was not present, so that no BSN travels in the url.",
            "direction": "request",
            "stopTestOnFail": false,
            "warningOnly": false
          }
        },
        {
          "assert": {
            "extension": [
              {
                "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-assert-additional-operators",
                "valueCode": "notExists"
              },
              {
                "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-assert-query-parameter",
                "valueString": "subject"
              }
            ],
            "description": "Confirm that query parameter 'subject' was not present, so that no BSN travels in the url.",
            "direction": "request",
            "stopTestOnFail": false,
            "warningOnly": false
          }
        },
        {
          "assert": {
            "extension": [
              {
                "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-assert-additional-operators",
                "valueCode": "notExists"
              },
              {
                "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-assert-query-parameter",
                "valueString": "patient:identifier"
              }
            ],
            "description": "Confirm that query parameter 'patient:identifier' was not present, so that no BSN travels in the url.",
            "direction": "request",
            "stopTestOnFail": false,
            "warningOnly": false
          }
        },
        {
          "assert": {
            "extension": [
              {
                "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-assert-additional-operators",
                "valueCode": "notExists"
              },
              {
                "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-assert-query-parameter",
                "valueString": "subject:identifier"
              }
            ],
            "description": "Confirm that query parameter 'subject:identifier' was not present, so that no BSN travels in the url.",
            "direction": "request",
            "stopTestOnFail": false,
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "Confirm that the Burgerservicenummer naming system does not appear in the url in any form.",
            "direction": "request",
            "operator": "notContains",
            "requestURL": "fhir.nl/fhir/NamingSystem/bsn",
            "stopTestOnFail": false,
            "warningOnly": false
          }
        }
      ],
      "id": "self-dva-01",
      "name": "SELF-DVA-01",
      "description": "The envelope conforms, so every assert should be green. A warning on the kid is a defect here, because this token carries one."
    }
  ],
  "version": "0.1.0",
  "status": "active",
  "publisher": "GUPZ",
  "name": "Self_dva_01_envelope_conforms",
  "title": "SELF-DVA-01 - The token asserts pass on a conforming envelope",
  "description": "Presents a token with the envelope GUPZ-TOK-002 prescribes: five dot separated segments, and a JWE protected header declaring alg RSA-OAEP, enc A256CBC-HS512 and cty JWT, with a kid. Every assert of DVA-01 has to pass."
}
