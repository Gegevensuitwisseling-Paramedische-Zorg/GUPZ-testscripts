  "origin": [
    {
      "index": 1,
      "profile": {
        "code": "Conformancelab-Client",
        "system": "http://fhir.interoplab.eu/fhir/CodeSystem/Interoplab-CL-origin-profile"
      }
    }
  ],
  "destination": [
    {
      "index": 1,
      "profile": {
        "code": "FHIR-Server",
        "system": "http://terminology.hl7.org/CodeSystem/testscript-profile-destination-types"
      }
    }
  ],
  "test": [
    {
      "action": [
        {
          "operation": {
            "type": {
              "code": "search",
              "system": "http://hl7.org/fhir/restful-interaction"
            },
            "resource": "DocumentReference",
            "description": "Search for current DocumentReference resources.",
            "accept": "json",
            "destination": 1,
            "encodeRequestUrl": true,
            "origin": 1,
            "params": "?status=current"
          }
        },
        {
          "assert": {
            "description": "Confirm that the returned HTTP status is not 200 (OK).",
            "direction": "response",
            "operator": "notEquals",
            "responseCode": "200",
            "stopTestOnFail": true,
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "Check if the returned HTTP status is 401 (Unauthorized) or 403 (Forbidden). Assert is set to warning only because open-GUPZ issue #70 does not specify the response to a refused token, so other failure codes may be expected as well.",
            "direction": "response",
            "operator": "in",
            "responseCode": "401,403",
            "stopTestOnFail": false,
            "warningOnly": true
          }
        }
      ],
      "id": "04",
      "name": "AUTH-04",
      "description": "A request without an Authorization header is refused"
    }
  ],
  "version": "0.1.0",
  "status": "active",
  "publisher": "GUPZ",
  "name": "Auth_04_no_authorization_header",
  "title": "AUTH-04 - A request without an Authorization header is refused",
  "description": "security.md requires the token on every call. A request without one must not be answered with data."
}
