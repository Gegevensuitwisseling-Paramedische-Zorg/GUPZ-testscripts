            },
            "resource": "DocumentReference",
            "description": "Search for current DocumentReference resources.",
            "accept": "json",
            "destination": 1,
            "encodeRequestUrl": true,
            "origin": 1,
            "params": "?status=current"
          }
        },
        {
          "assert": {
            "description": "Confirm that the operation was successful.",
            "direction": "response",
            "operator": "in",
            "responseCode": "200,201",
            "stopTestOnFail": true,
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "Confirm that the returned resource type is Bundle.",
            "direction": "response",
            "resource": "Bundle",
            "stopTestOnFail": false,
            "warningOnly": false
          }
        }
      ],
      "id": "02",
      "name": "AUTH-02",
      "description": "A signed but not encrypted token is accepted in connectathon mode"
    }
  ],
  "version": "0.1.0",
  "status": "active",
  "publisher": "GUPZ",
  "name": "Auth_02_signed_only_token",
  "title": "AUTH-02 - A signed but not encrypted token is accepted in connectathon mode",
  "description": "One of the three token variants agreed for the connectathon of 22 September 2026. Deviates from security.md, which prescribes sign then encrypt, so this case only applies to a platform running in connectathon mode."
}
