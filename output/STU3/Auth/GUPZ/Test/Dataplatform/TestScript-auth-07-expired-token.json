{
  "resourceType": "TestScript",
  "id": "auth-07-expired-token",
  "url": "https://gegevensuitwisseling-paramedische-zorg.github.io/GUPZ-testscripts/TestScript/auth-07-expired-token",
  "origin": [
    {
      "extension": [
        {
          "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-SUT",
          "valueBoolean": false
        }
      ],
      "index": 1,
      "profile": {
        "code": "FHIR-Client",
        "system": "http://terminology.hl7.org/CodeSystem/testscript-profile-origin-types"
      }
    }
  ],
  "destination": [
    {
      "extension": [
        {
          "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-SUT",
          "valueBoolean": true
        }
      ],
      "index": 1,
      "profile": {
        "code": "FHIR-Server",
        "system": "http://terminology.hl7.org/CodeSystem/testscript-profile-destination-types"
      }
    }
  ],
  "variable": [
    {
      "name": "token",
      "description": "T5: exp in the past, otherwise valid."
    },
    {
      "name": "X-Correlation-ID",
      "defaultValue": "${UUID}",
      "description": "X-Correlation-ID, by default a UUID following the MedMij Afsprakenstelsel. Does not have to be edited, see https://nictiz.atlassian.net/browse/MM-5132 for more information"
    }
  ],
  "test": [
    {
      "action": [
        {
          "operation": {
            "requestHeader": [
              {
                "field": "Authorization",
                "value": "Bearer ${token}"
              },
              {
                "field": "MedMij-Request-ID",
                "value": "${UUID}"
              },
              {
                "field": "X-Correlation-ID",
                "value": "${X-Correlation-ID}"
              }
            ],
            "type": {
              "code": "search",
              "system": "http://hl7.org/fhir/restful-interaction"
            },
            "resource": "DocumentReference",
            "description": "Search for current DocumentReference resources.",
            "accept": "json",
            "destination": 1,
            "encodeRequestUrl": true,
            "origin": 1,
            "params": "?status=current"
          }
        },
        {
          "assert": {
            "description": "Confirm that the returned HTTP status is not 200 (OK).",
            "direction": "response",
            "operator": "notEquals",
            "responseCode": "200",
            "stopTestOnFail": true,
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "Check if the returned HTTP status is 401 (Unauthorized) or 403 (Forbidden). Assert is set to warning only because open-GUPZ issue #70 does not specify the response to a refused token, so other failure codes may be expected as well.",
            "direction": "response",
            "operator": "in",
            "responseCode": "401,403",
            "stopTestOnFail": false,
            "warningOnly": true
          }
        }
      ],
      "id": "07",
      "name": "AUTH-07",
      "description": "An expired token is refused"
    }
  ],
  "version": "0.1.0",
  "status": "active",
  "publisher": "GUPZ",
  "name": "Auth_07_expired_token",
  "title": "AUTH-07 - An expired token is refused",
  "description": "security.md has the platform refuse a request once the expiration time has passed."
}
