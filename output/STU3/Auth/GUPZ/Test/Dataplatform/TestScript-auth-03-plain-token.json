{
  "resourceType": "TestScript",
  "id": "auth-03-plain-token",
  "url": "https://gegevensuitwisseling-paramedische-zorg.github.io/GUPZ-testscripts/TestScript/auth-03-plain-token",
  "origin": [
    {
      "extension": [
        {
          "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-SUT",
          "valueBoolean": false
        }
      ],
      "index": 1,
      "profile": {
        "code": "FHIR-Client",
        "system": "http://terminology.hl7.org/CodeSystem/testscript-profile-origin-types"
      }
    }
  ],
  "destination": [
    {
      "extension": [
        {
          "url": "http://fhir.interoplab.eu/fhir/StructureDefinition/Interoplab-CL-ext-SUT",
          "valueBoolean": true
        }
      ],
      "index": 1,
      "profile": {
        "code": "FHIR-Server",
        "system": "http://terminology.hl7.org/CodeSystem/testscript-profile-destination-types"
      }
    }
  ],
  "variable": [
    {
      "name": "token",
      "description": "T3: valid content, neither signed nor encrypted."
    },
    {
      "name": "X-Correlation-ID",
      "defaultValue": "${UUID}",
      "description": "X-Correlation-ID, by default a UUID following the MedMij Afsprakenstelsel. Does not have to be edited, see https://nictiz.atlassian.net/browse/MM-5132 for more information"
    }
  ],
  "test": [
    {
      "action": [
        {
          "operation": {
            "requestHeader": [
              {
                "field": "Authorization",
                "value": "Bearer ${token}"
              },
              {
                "field": "MedMij-Request-ID",
                "value": "${UUID}"
              },
              {
                "field": "X-Correlation-ID",
                "value": "${X-Correlation-ID}"
              }
            ],
            "type": {
              "code": "search",
              "system": "http://hl7.org/fhir/restful-interaction"
            },
            "resource": "DocumentReference",
            "description": "Search for current DocumentReference resources.",
            "accept": "json",
            "destination": 1,
            "encodeRequestUrl": true,
            "origin": 1,
            "params": "?status=current"
          }
        },
        {
          "assert": {
            "description": "Confirm that the operation was successful.",
            "direction": "response",
            "operator": "in",
            "responseCode": "200,201",
            "stopTestOnFail": true,
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "Confirm that the returned resource type is Bundle.",
            "direction": "response",
            "resource": "Bundle",
            "stopTestOnFail": false,
            "warningOnly": false
          }
        }
      ],
      "id": "03",
      "name": "AUTH-03",
      "description": "A plain token is accepted in connectathon mode"
    }
  ],
  "version": "0.1.0",
  "status": "active",
  "publisher": "GUPZ",
  "name": "Auth_03_plain_token",
  "title": "AUTH-03 - A plain token is accepted in connectathon mode",
  "description": "The second connectathon variant: the prescribed content, but neither signed nor encrypted. Note that what plain means exactly has not been agreed; an unsigned JWT per RFC 7519 is a JWS with alg none and an empty signature, which is not the same as a bare base64 payload."
}
