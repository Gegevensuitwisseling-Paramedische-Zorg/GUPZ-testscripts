{
  "info": {
    "name": "GUPZ dataplatform, hand checks",
    "description": "The requests the Dataplatform Test Sets make, so a response can be inspected by hand. Conformancelab drives the actual tests; this collection is for finding out whether a failing assert is caused by the script or by the server. Set baseUrl and token in the environment. Requests marked (auth) exist to compare an accepted and a refused response.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://hapi.fhir.org/baseDstu3" },
    { "key": "token", "value": "" },
    { "key": "tokenPatient2", "value": "" },
    { "key": "binaryId", "value": "example-pdfa-binary3" }
  ],
  "item": [
    {
      "name": "1.1 Search current DocumentReference",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/fhir+json" },
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "MedMij-Request-ID", "value": "{{$guid}}" },
          { "key": "X-Correlation-ID", "value": "{{$guid}}" }
        ],
        "url": { "raw": "{{baseUrl}}/DocumentReference?status=current" }
      }
    },
    {
      "name": "1.2 Search with a date range that yields nothing",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/fhir+json" },
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "MedMij-Request-ID", "value": "{{$guid}}" },
          { "key": "X-Correlation-ID", "value": "{{$guid}}" }
        ],
        "url": { "raw": "{{baseUrl}}/DocumentReference?indexed=ge2024-08-20&indexed=le2025-08-20&status=current" }
      }
    },
    {
      "name": "1.3 Malformed search, expect an OperationOutcome",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/fhir+json" },
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "MedMij-Request-ID", "value": "{{$guid}}" },
          { "key": "X-Correlation-ID", "value": "{{$guid}}" }
        ],
        "url": { "raw": "{{baseUrl}}/DocumentReference/$" }
      }
    },
    {
      "name": "1.5 Read an unknown Binary, expect an OperationOutcome",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/fhir+json" },
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "MedMij-Request-ID", "value": "{{$guid}}" },
          { "key": "X-Correlation-ID", "value": "{{$guid}}" }
        ],
        "url": { "raw": "{{baseUrl}}/Binary/{{binaryId}}" }
      }
    },
    {
      "name": "2.2 Search DocumentManifest, expect 404 not-supported",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/fhir+json" },
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "MedMij-Request-ID", "value": "{{$guid}}" },
          { "key": "X-Correlation-ID", "value": "{{$guid}}" }
        ],
        "url": { "raw": "{{baseUrl}}/DocumentManifest?status=current" }
      }
    },
    {
      "name": "AUTH-01 (auth) Same search with a valid token",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/fhir+json" },
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "MedMij-Request-ID", "value": "{{$guid}}" },
          { "key": "X-Correlation-ID", "value": "{{$guid}}" }
        ],
        "url": { "raw": "{{baseUrl}}/DocumentReference?status=current" }
      }
    },
    {
      "name": "AUTH-04 (auth) No Authorization header, expect 401",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/fhir+json" },
          { "key": "MedMij-Request-ID", "value": "{{$guid}}" },
          { "key": "X-Correlation-ID", "value": "{{$guid}}" }
        ],
        "url": { "raw": "{{baseUrl}}/DocumentReference?status=current" }
      }
    },
    {
      "name": "AUTH-05 (auth) Header without the Bearer prefix, expect 401",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/fhir+json" },
          { "key": "Authorization", "value": "{{token}}" },
          { "key": "MedMij-Request-ID", "value": "{{$guid}}" },
          { "key": "X-Correlation-ID", "value": "{{$guid}}" }
        ],
        "url": { "raw": "{{baseUrl}}/DocumentReference?status=current" }
      }
    },
    {
      "name": "AUTH-11b (auth) Same search with the second patient's token",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/fhir+json" },
          { "key": "Authorization", "value": "Bearer {{tokenPatient2}}" },
          { "key": "MedMij-Request-ID", "value": "{{$guid}}" },
          { "key": "X-Correlation-ID", "value": "{{$guid}}" }
        ],
        "url": { "raw": "{{baseUrl}}/DocumentReference?status=current" }
      }
    },
    {
      "name": "JWKS of the platform",
      "request": {
        "method": "GET",
        "header": [ { "key": "Accept", "value": "application/json" } ],
        "url": { "raw": "{{baseUrl}}/.well-known/jwks.json" }
      }
    }
  ]
}
