{
    "request": {
        "method": "GET",
        "urlPathPattern": ".*"
    },
    "response": {
        "status": 401,
        "headers": {
            "WWW-Authenticate": "Bearer realm=\"GUPZ\", error=\"invalid_token\", error_description=\"The access token expired\"",
            "Content-Type": "application/fhir+json"
        },
        "jsonBody": {
            "resourceType": "OperationOutcome",
            "issue": [
                {
                    "severity": "error",
                    "code": "forbidden",
                    "diagnostics": "The access token expired"
                }
            ]
        }
    }
}
